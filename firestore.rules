rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function verifiedOwner() {
      return signedIn()
          && request.auth.token.email == 'glheffne@go.olemiss.edu'
          && request.auth.token.email_verified == true;
    }

    match /countries/{countryId} {
      // Project 5: countries are retrieved from Firebase after sign-in.
      allow get, list: if signedIn();
      // Only a verified project owner can run the one-time import.
      allow create, update: if verifiedOwner();
      allow delete: if false;
    }

    match /contactMessages/{messageId} {
      // Users can write their own feedback, but cannot read messages.
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'topic', 'message', 'createdAt'])
          && request.resource.data.keys().hasAll(['uid', 'name', 'email', 'topic', 'message', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.topic in [
              'General question', 'Food information', 'Cultural correction',
              'Website feedback', 'Other'
          ]
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 3000
          && request.resource.data.createdAt == request.time;
      allow get, list, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
